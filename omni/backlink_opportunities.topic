# omni/backlink_opportunities.topic
#
# Mock Omni topic file (not connected to a live Omni instance): the default
# Growth Marketing lens over the backlink_opportunities view. Syntax verified
# against fetched docs:
#   https://docs.omni.co/modeling/topics/index.md
#   https://docs.omni.co/modeling/topics/setup.md
#   https://docs.omni.co/modeling/topics/parameters/index.md       (full parameter list)
#   https://docs.omni.co/modeling/topics/parameters/base-view.md   (required)
#   https://docs.omni.co/modeling/topics/parameters/label.md
#   https://docs.omni.co/modeling/topics/parameters/description.md
#   https://docs.omni.co/modeling/topics/parameters/default-filters.md
#   https://docs.omni.co/modeling/topics/parameters/sample-queries.md
#   https://docs.omni.co/modeling/filters/index.md
#   https://docs.omni.co/modeling/filters/operators/greater-than-or-equal-to.md
#   https://docs.omni.co/modeling/models/topics.md                 (deprecation, see below)
#
# Topics used to be embeddable as a `topics:` list inside a model file (the
# brief's draft did this, nested under omni/backlinks.model.yaml). As of
# 2024-12-10 that is deprecated: model files with an embedded `topics:` key
# now error on save (docs.omni.co/modeling/models/topics.md). This mock uses
# a standalone topic file instead, which is the only currently-valid form.
#
# File extension: `.topic`, chosen by analogy with the two extensions the
# docs state explicitly -- view files are `<name>.view`, and saved query
# views are `<name>.query.view` (docs.omni.co/modeling/views/parameters/name.md,
# docs.omni.co/modeling/query-views/index.md). No fetched page gives a
# literal "named foo.topic" example the way it does for views, so this
# specific extension is an inference from that pattern, not a direct quote --
# flagged as such in task-10-report.md.
#
# There is no `default_sort` (or any `sort`) topic-level parameter -- checked
# the full parameter list linked above. The closest documented mechanism for
# a pre-built, sorted default view is `sample_queries`, which
# docs.omni.co/modeling/topics/setup.md also recommends as the way to
# reinforce a topic's primary use case. So the brief's "sort by
# opportunity_score desc" default lens is expressed as the sample query
# below, capped at 25 rows to match the report's own top-25 contract.

base_view: backlink_opportunities
label: Backlink Opportunities
description: |
  Referring domains that link to at least two of Sigma, Hex, Mode, or
  Lightdash but not to omni.co, ranked by outreach opportunity score.
  Built from Common Crawl's May and June 2026 web graph releases via
  mart_backlink_opportunities.

# Redundant with the mart's own WHERE clause today (every row already has
# competitor_count >= 2), but kept as an explicit, visible-and-removable
# default per the brief: it documents intent in the semantic layer itself
# and keeps the topic correct if the mart's threshold is ever loosened.
default_filters:
  backlink_opportunities.competitor_count:
    greater_than_or_equal_to: 2

sample_queries:
  Top 25 Opportunities:
    query:
      fields: [
        backlink_opportunities.source_domain,
        backlink_opportunities.category,
        backlink_opportunities.competitor_count,
        backlink_opportunities.authority_percentile,
        backlink_opportunities.opportunity_score
      ]
      base_view: backlink_opportunities
      sorts:
        - field: backlink_opportunities.opportunity_score
          desc: true
      limit: 25
      topic: backlink_opportunities
    description: The default Growth Marketing lens -- qualifying domains ranked by opportunity score, highest first, matching the top-25 outreach report.
    prompt: Show me our best backlink opportunities to pursue
